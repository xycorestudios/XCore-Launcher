<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Version metadata, libraries, assets and the client jar all come from Mojang's endpoints. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".XCoreApplication"
        android:allowBackup="false"
        android:icon="@drawable/xlauncherlogo"
        android:label="@string/app_name"
        android:roundIcon="@drawable/xlauncherlogo"
        android:supportsRtl="true"
        android:theme="@style/Theme.XCore">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:exported="true"
            android:label="@string/app_name"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.XCore"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
