<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Bottom Panorama Backdrop -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="230dp"
        android:layout_gravity="bottom"
        android:alpha="0.22"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/hero_panorama" />

    <!-- Settings Cards List -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp">

            <!-- 1. General -->
            <include
                android:id="@+id/setting_general"
                layout="@layout/item_setting" />

            <!-- 2. Graphics -->
            <include
                android:id="@+id/setting_graphics"
                layout="@layout/item_setting" />

            <!-- 3. Controls -->
            <include
                android:id="@+id/setting_controls"
                layout="@layout/item_setting" />

            <!-- 4. Storage -->
            <include
                android:id="@+id/setting_storage"
                layout="@layout/item_setting" />

            <!-- 5. Account -->
            <include
                android:id="@+id/setting_account"
                layout="@layout/item_setting" />

            <!-- 6. Security -->
            <include
                android:id="@+id/setting_security"
                layout="@layout/item_setting" />

            <!-- 7. About -->
            <include
                android:id="@+id/setting_about"
                layout="@layout/item_setting" />

        </LinearLayout>

    </ScrollView>

</FrameLayout>
