<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bottom_nav_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="14dp"
    android:layout_marginEnd="14dp"
    android:layout_marginBottom="6dp"
    android:background="@drawable/bg_bottom_nav"
    android:baselineAligned="false"
    android:orientation="horizontal"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <!-- Tab 1: My Instances -->
    <LinearLayout
        android:id="@+id/tab_instances"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/iv_tab_instances"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@string/nav_instances"
            android:src="@drawable/ic_cube" />

        <TextView
            android:id="@+id/tv_tab_instances"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="monospace"
            android:text="@string/nav_instances"
            android:textColor="@color/xcore_accent"
            android:textSize="12sp"
            android:textStyle="bold" />

        <View
            android:id="@+id/v_indicator_instances"
            android:layout_width="38dp"
            android:layout_height="3dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_indicator_line" />
    </LinearLayout>

    <!-- Tab 2: Files -->
    <LinearLayout
        android:id="@+id/tab_files"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/iv_tab_files"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@string/nav_files"
            android:src="@drawable/ic_folder" />

        <TextView
            android:id="@+id/tv_tab_files"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="monospace"
            android:text="@string/nav_files"
            android:textColor="@color/xcore_text_muted"
            android:textSize="12sp" />

        <View
            android:id="@+id/v_indicator_files"
            android:layout_width="38dp"
            android:layout_height="3dp"
            android:layout_marginTop="4dp"
            android:background="@android:color/transparent" />
    </LinearLayout>

    <!-- Tab 3: Settings -->
    <LinearLayout
        android:id="@+id/tab_settings"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/iv_tab_settings"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@string/nav_settings"
            android:src="@drawable/ic_gear" />

        <TextView
            android:id="@+id/tv_tab_settings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="monospace"
            android:text="@string/nav_settings"
            android:textColor="@color/xcore_text_muted"
            android:textSize="12sp" />

        <View
            android:id="@+id/v_indicator_settings"
            android:layout_width="38dp"
            android:layout_height="3dp"
            android:layout_marginTop="4dp"
            android:background="@android:color/transparent" />
    </LinearLayout>

</LinearLayout>
