<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Hero Banner -->
        <include
            android:id="@+id/hero_banner"
            layout="@layout/layout_hero_banner" />

        <!-- Section Title: My Instances -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <View
                android:id="@+id/v_indicator"
                android:layout_width="4dp"
                android:layout_height="20dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:background="@drawable/bg_indicator_bar" />

            <ImageView
                android:id="@+id/btn_create_instance"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/empty_instances_sub"
                android:padding="7dp"
                android:src="@drawable/ic_plus" />

            <TextView
                android:id="@+id/tv_section_instances"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="10dp"
                android:layout_toStartOf="@id/btn_create_instance"
                android:layout_toEndOf="@id/v_indicator"
                android:fontFamily="monospace"
                android:text="@string/nav_instances"
                android:textColor="@color/xcore_text"
                android:textSize="18sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <!-- Instances List Container -->
        <LinearLayout
            android:id="@+id/container_instances_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <include layout="@layout/item_instance" />
        </LinearLayout>

        <!-- Empty State Container -->
        <LinearLayout
            android:id="@+id/container_empty_state"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp">

            <ImageView
                android:layout_width="58dp"
                android:layout_height="58dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_cube" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="monospace"
                android:text="@string/empty_instances_title"
                android:textColor="@color/xcore_text_muted"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="monospace"
                android:text="@string/empty_instances_sub"
                android:textColor="@color/xcore_text_muted"
                android:textSize="13sp" />
        </LinearLayout>

    </LinearLayout>

</ScrollView>
