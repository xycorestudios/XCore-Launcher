<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        The UI is built on Android XML layouts with custom XML animations and drawables.
    -->
    <style name="Theme.XCore" parent="@android:style/Theme.Material">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowBackground">@color/xcore_bg</item>
        <item name="android:colorBackground">@color/xcore_bg</item>
        <item name="android:textColorPrimary">@color/xcore_text</item>
        <item name="android:textColorSecondary">@color/xcore_text_muted</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:colorAccent">@color/xcore_accent</item>
    </style>

    <style name="XCoreDialogAnimation">
        <item name="android:windowEnterAnimation">@anim/anim_dialog_in</item>
        <item name="android:windowExitAnimation">@anim/anim_dialog_out</item>
    </style>

    <!-- Used when the Animations switch is off: the window swaps with no tween at all. -->
    <style name="XCoreDialogAnimationInstant">
        <item name="android:windowEnterAnimation">@null</item>
        <item name="android:windowExitAnimation">@null</item>
    </style>
</resources>
