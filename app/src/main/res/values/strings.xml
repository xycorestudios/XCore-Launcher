    <!-- Settings dialogs -->
    <string name="choice_language_note">Only English strings are compiled into this APK, so the list holds one entry. A locale appears here when its values directory exists.</string>
    <string name="choice_theme_note">This build ships one dark palette. Choosing a second theme needs a light resource set, which does not exist yet, so the dialog refuses to store one.</string>
    <string name="choice_runtime_channel_note">LOCAL_ONLY never contacts the network: the installer will only use components already recorded as installed.</string>
    <string name="choice_log_level_note">The engine logger filters at this level; the memory log keeps its own capacity setting.</string>
    <string name="choice_history_note">This is the retention window for launch records in the metadata database.</string>
    <string name="reset_title">Reset launcher settings</string>
    <string name="reset_note">Configuration keys return to their defaults. Instances, the selected instance and the EULA acknowledgement are separate records and stay as they are.</string>
    <string name="action_reset">Reset</string>
    <string name="animations_note">Turning this off clears the window animation style, so dialogs and screen changes swap instantly. It takes effect for dialogs opened from now on.</string>
    <string name="value_none">none</string>

