<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/mc_green_deep" />
            <corners android:radius="2dp" />
            <stroke android:width="1dp" android:color="@color/mc_green_bright" />
        </shape>
    </item>
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/mc_row_active" />
            <corners android:radius="2dp" />
            <stroke android:width="1dp" android:color="@color/mc_line" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/mc_green" />
            <corners android:radius="2dp" />
            <stroke android:width="1dp" android:color="@color/mc_green_deep" />
        </shape>
    </item>
</selector>
